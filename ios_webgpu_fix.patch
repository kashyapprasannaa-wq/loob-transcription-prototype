+// iOS/iPadOS Safari exposes navigator.gpu, but its WebGPU memory ceiling is far
+// lower than desktop and cannot hold fp32 Whisper-small — the GPU buffer
+// allocation OOM-kills the tab, which WebKit recovers from by reloading the page,
+// producing a "100% then restart" loop that looks like a failed download but is
+// actually a post-download crash. So: detect iOS/iPadOS and never send it fp32.
+// iPadOS 13+ reports as a Mac, so also treat touch-capable "Macs" as iPadOS.
+function isAppleMobile() {
+  const ua = navigator.userAgent || "";
+  const iOS = /iPad|iPhone|iPod/.test(ua);
+  const iPadOSAsMac = navigator.platform === "MacIntel"
+    && typeof navigator.maxTouchPoints === "number"
+    && navigator.maxTouchPoints > 1;
+  return iOS || iPadOSAsMac;
+}
+
+// Returns { device, dtype } that actually fits this environment.
+function pickBackend() {
+  const appleMobile = isAppleMobile();
+  if (navigator.gpu && !appleMobile) {
+    // Desktop / Android WebGPU: fp32 is fine and fastest.
+    return { device: "webgpu", dtype: "fp32" };
+  }
+  if (navigator.gpu && appleMobile) {
+    // iOS/iPadOS with WebGPU: use it, but only quantized so it fits the
+    // mobile GPU memory budget. q4 for the encoder/decoder keeps buffers small.
+    return {
+      device: "webgpu",
+      dtype: { encoder_model: "q4", decoder_model_merged: "q4" },
+    };
+  }
+  // No WebGPU at all: CPU WASM with q8.
+  return { device: "wasm", dtype: "q8" };
+}
+
+async function loadWithBackend(backend) {
+  return pipeline(
+    "automatic-speech-recognition",
