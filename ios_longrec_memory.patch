+// returns just the [start, end) sample boundaries. The loop slices one chunk at
+// a time from these and frees it immediately after transcribing, so only a
+// single 15s chunk of audio is ever alive on top of the base recording.
+function chunkBoundaries(totalLen, sampleRate = 16000, chunkS = 15, strideS = 3) {
+  const chunkSize = chunkS * sampleRate;
+  const step = chunkSize - strideS * sampleRate;
+  const bounds = [];
+  if (totalLen <= chunkSize) { bounds.push([0, totalLen]); return bounds; }
+  for (let start = 0; start < totalLen; start += step) {
+    const end = Math.min(start + chunkSize, totalLen);
+    bounds.push([start, end]);
+    if (end >= totalLen) break;
+  }
+  return bounds;
+}
